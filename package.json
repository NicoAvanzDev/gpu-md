{
  "name": "gpu-md",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && npm run build:site && npm run build:lib",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "tsx scripts/run-browser-tests.ts",
    "test:conformance": "tsx scripts/evaluate.ts --check",
    "train": "tsx scripts/dataset.ts && uv run python scripts/train.py --device cuda",
    "evaluate": "tsx scripts/evaluate.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "benchmark:cuda": "tsx scripts/benchmark-input.ts && uv run python scripts/benchmark-cuda.py",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run format:check",
    "build:site": "vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "test:package": "tsx scripts/verify-package.ts",
    "test:python": "python3 -m compileall -q scripts",
    "validate": "npm run check && npm test && npm run test:conformance && npm run build && npm run test:package && npm run test:python",
    "prepack": "npm run build:lib",
    "prepublishOnly": "npm run validate",
    "train:cpu": "tsx scripts/dataset.ts && uv run python scripts/train.py --device cpu",
    "test:production": "tsx scripts/verify-production.ts"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.0",
    "@webgpu/types": "^0.1.72",
    "agent-browser": "^0.37.1",
    "entities": "^8.1.0",
    "markdown-it": "^15.0.1",
    "mdurl": "^2.1.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.2.2"
  },
  "description": "Markdown rendering with a compact neural classifier, WebGPU acceleration, and CPU fallback.",
  "license": "MIT",
  "author": "NicoAvanzDev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NicoAvanzDev/gpu-md.git"
  },
  "homepage": "https://github.com/NicoAvanzDev/gpu-md#readme",
  "bugs": {
    "url": "https://github.com/NicoAvanzDev/gpu-md/issues"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "main": "./lib/gpu-md.js",
  "module": "./lib/gpu-md.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/gpu-md.js",
      "default": "./lib/gpu-md.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "docs",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "evaluation.json",
    "performance.json",
    "demo-performance.json",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "sideEffects": false,
  "keywords": [
    "markdown",
    "webgpu",
    "parser",
    "typescript",
    "machine-learning"
  ]
}
